{
  "name": "@desk/ui",
  "version": "0.0.0",
  "description": "React components for admin apps and browser desktops: forms, data display, feedback, and a desktop shell.",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "desktop",
    "window-manager"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/ui.css",
    "./test-setup": "./src/test-setup.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/clean-types.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "1.66.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0"
  },
  "files": [
    "dist",
    "!dist/types/**/*.test.d.ts"
  ],
  "peerDependenciesMeta": {
    "@testing-library/jest-dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/ui.js"
      },
      "./styles.css": "./dist/ui.css",
      "./test-setup": {
        "types": "./dist/types/test-setup.d.ts",
        "default": "./dist/test-setup.js"
      }
    }
  }
}
